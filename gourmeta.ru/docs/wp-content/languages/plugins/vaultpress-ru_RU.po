msgid "There was a problem trying to register your VaultPress subscription."
msgstr "В процессе оформления подписки VaultPress возникла проблема."

#: vaultpress.php:435
msgid "%s Security Threat"
msgid_plural "%s Security Threats"
msgstr[0] "%s угроза безопасности"
msgstr[1] "%s угрозы безопасности"
msgstr[2] "%s угроз безопасности"

#: vaultpress.php:439
msgid "Visit VaultPress Security"
msgstr "Перейти к VaultPress Security"

#: vaultpress.php:530 vaultpress.php:933
msgid "VaultPress needs your attention!"
msgstr "VaultPress требует вашего внимания!"

#: vaultpress.php:538
msgid "Each site will need to be registered with VaultPress separately. You can purchase new keys from your <a href=\"%1$s\">VaultPress&nbsp;Dashboard</a>."
msgstr "Каждый сайт необходимо регистрировать в VaultPress отдельно. Вы можете приобрести новые ключи в своей <a href=\"%1$s\">панели управления VaultPress</a>."

#: vaultpress.php:541
msgid "VaultPress has been activated across your network!"
msgstr "VaultPress активирован в вашей сети!"

#: vaultpress.php:723
msgid "<strong>Failed to register VaultPress via Jetpack</strong>: %s. If you&rsquo;re still having issues please <a href=\"%1$s\">contact the VaultPress&nbsp;Safekeepers</a>."
msgstr "<strong>Не удалось зарегистрировать VaultPress через Jetpack</strong>: %s. Если у вас остались вопросы, пожалуйста, <a href=\"%1$s\">свяжитесь с сотрудниками VaultPress</a>."

#: vaultpress.php:738
msgid "<strong>That's not a valid registration key.</strong> Head over to the <a href=\"%1$s\" title=\"Sign in to your VaultPress Dashboard\">VaultPress&nbsp;Dashboard</a> to find your key."
msgstr "<strong>Предоставлен недействительный регистрационный ключ.</strong> Перейдите в <a href=\"%1$s\" title=\"Войдите в свой личный кабинет VaultPress\">панель управления VaultPress</a>, чтобы найти свой ключ."

#: vaultpress.php:762
msgid "There was a problem trying to register your subscription. Please try again. If you&rsquo;re still having issues please <a href=\"%1$s\">contact the VaultPress&nbsp;Safekeepers</a>."
msgstr "В процессе оформления подписки возникла проблема. Попробуйте еще раз. Если у вас остались вопросы, пожалуйста, <a href=\"%1$s\">свяжитесь с сотрудниками VaultPress</a>."